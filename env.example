# LLM provider switch: "openrouter" (default), "anthropic", or "openai".
# See docs/openrouter-integration.md for the full writeup of why
# openrouter is the default and the model-specific quirks/known risks.
LLM_PROVIDER=openrouter

# Required if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — defaults to anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional — defaults to "low". claude-sonnet-5.5 has MANDATORY reasoning
# on OpenRouter (defaults to "high", slow/expensive, if left unset).
OPENROUTER_REASONING_EFFORT=low

# Optional — defaults to 16384. Explicit output-token cap; left unset,
# OpenRouter defaults to the model's theoretical max output, which can
# trigger a 402 "insufficient credits" error regardless of actual
# remaining balance. See docs/openrouter-integration.md §5.
OPENROUTER_MAX_TOKENS=16384

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...

# Optional — defaults to gpt-5.1
OPENAI_MODEL=gpt-5.1

# Optional — shared across all providers above.
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
